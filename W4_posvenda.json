    {
      "parameters": {
        "jsCode": "const doc = $json;\nlet raw = String(($json.contact_mobile || '').replace(/\\D/g, '') || '').replace(/\\D/g, '');\nlet telefone_normalizado;\nif (raw.startsWith('55') && raw.length >= 12) {\n  telefone_normalizado = '+' + raw;\n} else if (raw.length === 10 || raw.length === 11) {\n  telefone_normalizado = '+55' + raw;\n} else {\n  telefone_normalizado = '+' + raw;\n}\nreturn [{ json: { ...doc, telefone_normalizado } }];\n"
      },
      "id": "normaliza-tel-0-whatsapp-pede-avalia-o",
      "name": "Normaliza Telefone (WhatsApp — Pede Avaliação)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "if ($json.body && $json.body.message_type !== 'incoming') {\n  return [];\n}\nreturn [{ json: $json }];\n"
      },
      "id": "filtro-incoming",
      "name": "Filtra Apenas Mensagens de Entrada",
