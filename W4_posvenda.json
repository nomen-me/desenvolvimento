        "jsonBody": "{\"content\": \"Que ótimo, *{{$json.nome}}*! 🎉 Ficamos muito felizes!\\n\\nAté a próxima compra! 😊\", \"message_type\": \"outgoing\", \"private\": false}"
      },
      "id": "reply-positivo",
      "name": "WhatsApp — Agradece Avaliação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        740
