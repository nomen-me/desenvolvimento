> /* Hortifrúti / Pesáveis — contingência visual (pdvHf*). Sem rolagem vertical: categorias em grade fixa, produtos paginados. */
> .pdv-hf-wrap{display:none;flex:1;flex-direction:column;min-height:0;padding:12px 16px;gap:10px;overflow:hidden}
> .pdv-hf-wrap.open{display:flex}
> .pdv-hf-wrap:focus{outline:none}
> .pdv-hf-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
> .pdv-hf-top .pdv-hf-titulo{font-size:14px;font-weight:600;margin-right:auto}
> .pdv-hf-plu{width:150px;font-family:var(--mono)}
> .pdv-hf-aviso{font-size:11.5px;padding:6px 10px;border-radius:8px;border:1px solid var(--rule);color:var(--ghost)}
> .pdv-hf-aviso.off{border-color:var(--danger);color:var(--danger)}
> .pdv-hf-ultimo{font-size:12px;color:var(--signal);min-height:16px}
> .pdv-hf-cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-content:start}
> .pdv-hf-prods{flex:1;min-height:0;overflow:hidden;display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));grid-auto-rows:150px;gap:10px;align-content:start}
> .pdv-hf-tile{background:var(--ink-mid);border:1px solid var(--rule);border-radius:10px;color:inherit;font:inherit;cursor:pointer;text-align:center;position:relative;padding:10px}
> .pdv-hf-tile:hover,.pdv-hf-tile:focus-visible{border-color:var(--signal);outline:none}
> .pdv-hf-tile.esgotado{opacity:.4;cursor:not-allowed}
> .pdv-hf-cat{min-height:110px;font-size:15px;font-weight:600;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}
> .pdv-hf-cat small{font-size:11px;font-weight:400;color:var(--ghost)}
> .pdv-hf-atalho{position:absolute;top:6px;left:8px;font-family:var(--mono);font-size:10px;color:var(--ghost)}
> .pdv-hf-foto{width:100%;height:82px;object-fit:cover;border-radius:6px;display:block;margin-bottom:6px;background:var(--ink)}
> .pdv-hf-foto.semfoto{display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:600;color:var(--ghost)}
> .pdv-hf-nome{font-size:12px;font-weight:600;line-height:1.25;max-height:30px;overflow:hidden}
> .pdv-hf-codigo{font-family:var(--mono);font-size:11px;color:var(--signal);margin-top:2px}
> .pdv-hf-pager{display:flex;align-items:center;justify-content:center;gap:10px;font-size:12px;color:var(--ghost)}
