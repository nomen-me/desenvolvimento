> /* ---- Hortifrúti / Pesáveis — contingência visual de identificação.
>    Reaproveita só o que já existe: catálogo local (Item → IndexedDB 'catalogo'),
>    a árvore nativa de categorias do ERPNext (Item Group, em 'config'), a foto
>    nativa do Item (Item.image) e o MESMO lançamento do PDV
>    (adicionarAoCarrinhoPDVPorCodigo). "PLU" = item_code, o identificador que o
>    PDV já usa para bipar (buscarProdutoPDV com Enter) — não existe tabela de
>    PLU paralela. Funciona offline e só com teclado e mouse. A visão computacional
>    é o caminho principal; este painel NUNCA depende dela: pdvVisao só informa o
>    estado ao operador (quem integrar a câmera chama pdvVisaoMarcar*). ---- */
> const PDV_HF_GRUPO_RAIZ = 'Hortifrúti'; // grupo-pai em Item Group; as categorias são seus filhos diretos (comparação sem acento/caixa)
> const PDV_HF_OUTRAS = '__outras__';
> let pdvHfAberto = false, pdvHfCategoria = null, pdvHfPagina = 0, pdvHfGrupos = [];
> const pdvVisao = { disponivel: null, motivo: null };
> function pdvVisaoMarcarIndisponivel(motivo){ pdvVisao.disponivel = false; pdvVisao.motivo = motivo || 'indisponível'; pdvHfAtualizarAviso(); }
> function pdvVisaoMarcarDisponivel(){ pdvVisao.disponivel = true; pdvVisao.motivo = null; pdvHfAtualizarAviso(); }
> function pdvHfNorm(s){ return String(s == null ? '' : s).normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase(); }
> function pdvHfCategoriaDe(grupo){
>   if (!grupo) return null;
>   const raizN = pdvHfNorm(PDV_HF_GRUPO_RAIZ);
>   if (pdvHfNorm(grupo) === raizN) return PDV_HF_OUTRAS;
>   let atual = pdvHfGrupos.find(g => g.name === grupo), guarda = 0;
>   while (atual && guarda++ < 20){
>     if (atual.parent && pdvHfNorm(atual.parent) === raizN) return atual.name;
>     atual = pdvHfGrupos.find(g => g.name === atual.parent);
>   }
>   return null;
> }
> function pdvHfProdutos(){
>   return pdvCatalogoCache.map(p => ({ p, cat: pdvHfCategoriaDe(p.categoria) })).filter(x => x.cat);
> }
> function pdvHfCategorias(){
>   const cont = {};
>   pdvHfProdutos().forEach(x => { cont[x.cat] = (cont[x.cat] || 0) + 1; });
>   const lista = Object.keys(cont).map(k => ({ chave: k, nome: k === PDV_HF_OUTRAS ? 'Outras' : k, qtd: cont[k] }));
>   lista.sort((a, b) => (a.chave === PDV_HF_OUTRAS) - (b.chave === PDV_HF_OUTRAS) || a.nome.localeCompare(b.nome, 'pt-BR'));
>   return lista;
> }
> function pdvHfImgUrl(img){
>   if (!img) return null;
>   if (/^https?:\/\//i.test(img)) return img;
>   return img.charAt(0) === '/' ? SYNAPSE_ENV.ritmo + img : null;
> }
> function pdvHfImgErro(el){
>   const d = document.createElement('div'); d.className = 'pdv-hf-foto semfoto'; d.textContent = el.getAttribute('data-ini') || '?';
>   el.replaceWith(d);
> }
> async function pdvHfAbrir(){
>   const op = document.getElementById('pdv-operacao');
>   if (!op || op.style.display === 'none' || !pdvCaixaAtual){ toast('Abra o caixa para usar Hortifrúti / Pesáveis', 'err'); return; }
>   try { const cfg = await pdvGet('config', 'grupos_item'); pdvHfGrupos = (cfg && cfg.itens) || []; } catch(e){ pdvHfGrupos = []; }
>   pdvHfAberto = true; pdvHfCategoria = null; pdvHfPagina = 0;
>   document.getElementById('pdv-produto-grid').style.display = 'none';
>   document.getElementById('pdv-hf').classList.add('open');
>   pdvHfAtualizarAviso();
>   pdvHfRender();
>   document.getElementById('pdv-hf-plu').focus();
> }
> function pdvHfFechar(){
>   pdvHfAberto = false;
>   document.getElementById('pdv-hf').classList.remove('open');
>   document.getElementById('pdv-produto-grid').style.display = '';
>   const b = document.getElementById('pdv-busca-produto'); if (b) b.focus();
> }
> function pdvHfVoltar(){ if (pdvHfCategoria){ pdvHfCategoria = null; pdvHfPagina = 0; pdvHfRender(); document.getElementById('pdv-hf-plu').focus(); } else pdvHfFechar(); }
> function pdvHfAtualizarAviso(){
>   const el = document.getElementById('pdv-hf-aviso'); if (!el) return;
>   const off = pdvVisao.disponivel === false;
>   el.classList.toggle('off', off);
>   el.textContent = off
>     ? 'Identificação automática indisponível (' + pdvVisao.motivo + ') — escolha a categoria e o produto, ou digite o PLU e Enter.'
>     : (pdvVisao.disponivel === true ? 'Identificação automática ativa. Se falhar, escolha a categoria e o produto, ou digite o PLU e Enter.'
>                                     : 'Escolha a categoria e o produto, ou digite o PLU e Enter.');
> }
> function pdvHfRender(){
>   const corpo = document.getElementById('pdv-hf-corpo'); if (!corpo) return;
>   const titulo = document.getElementById('pdv-hf-titulo'), vt = document.getElementById('pdv-hf-voltar-txt');
>   if (!pdvHfCategoria){
>     titulo.textContent = 'Hortifrúti / Pesáveis'; vt.textContent = 'Voltar às vendas';
>     const cats = pdvHfCategorias();
>     if (!cats.length){
>       corpo.innerHTML = '<div style="color:var(--ghost);font-size:12.5px;padding:24px 0">Nenhum produto de ' + pdvEscHtml(PDV_HF_GRUPO_RAIZ) + ' no catálogo local. Cadastre os Itens no grupo "' + pdvEscHtml(PDV_HF_GRUPO_RAIZ) + '" (ou em subgrupos) e sincronize. O PLU digitado continua funcionando para qualquer Item do catálogo.</div>';
>       return;
>     }
>     corpo.innerHTML = '<div class="pdv-hf-cats" id="pdv-hf-lista">' + cats.map((c, i) =>
>       '<button type="button" class="pdv-hf-tile pdv-hf-cat" data-cat="' + pdvEsc(c.chave) + '" onclick="pdvHfEscolherCategoria(this.dataset.cat)">' +
>       (i < 9 ? '<span class="pdv-hf-atalho">Alt+' + (i + 1) + '</span>' : '') + pdvEscHtml(c.nome) + '<small>' + c.qtd + ' produto' + (c.qtd === 1 ? '' : 's') + '</small></button>').join('') + '</div>';
>     return;
>   }
>   const nomeCat = pdvHfCategoria === PDV_HF_OUTRAS ? 'Outras' : pdvHfCategoria;
>   titulo.textContent = 'Hortifrúti / Pesáveis — ' + nomeCat; vt.textContent = 'Categorias';
>   corpo.innerHTML = '<div class="pdv-hf-prods" id="pdv-hf-lista"></div><div class="pdv-hf-pager" id="pdv-hf-pager"></div>';
>   pdvHfRenderProdutos();
> }
> function pdvHfRenderProdutos(){
>   const area = document.getElementById('pdv-hf-lista'); if (!area || !pdvHfCategoria) return;
>   const itens = pdvHfProdutos().filter(x => x.cat === pdvHfCategoria).map(x => x.p).sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
>   const cols = Math.max(1, Math.floor((area.clientWidth + 10) / 140)), linhas = Math.max(1, Math.floor((area.clientHeight + 10) / 160));
>   const porPagina = Math.max(6, cols * linhas), paginas = Math.max(1, Math.ceil(itens.length / porPagina));
>   pdvHfPagina = Math.min(Math.max(0, pdvHfPagina), paginas - 1);
>   area.innerHTML = itens.slice(pdvHfPagina * porPagina, (pdvHfPagina + 1) * porPagina).map((p, i) => {
>     const esgotado = p.estoque != null && p.estoque <= 0, url = pdvHfImgUrl(p.imagem), ini = pdvEscHtml(String(p.nome).trim().slice(0, 2).toUpperCase());
>     const plu = /^\d{1,6}$/.test(p.item_code) ? '<div class="pdv-hf-codigo">PLU ' + pdvEscHtml(p.item_code) + '</div>' : '';
>     return '<button type="button" class="pdv-hf-tile pdv-hf-prod' + (esgotado ? ' esgotado' : '') + '" data-codigo="' + pdvEsc(p.item_code) + '"' + (esgotado ? ' disabled' : ' onclick="pdvHfLancar(this.dataset.codigo)"') + '>' +
>       (i < 9 ? '<span class="pdv-hf-atalho">Alt+' + (i + 1) + '</span>' : '') +
>       (url ? '<img class="pdv-hf-foto" src="' + pdvEsc(url) + '" alt="' + pdvEsc(p.nome) + '" data-ini="' + ini + '" onerror="pdvHfImgErro(this)">' : '<div class="pdv-hf-foto semfoto">' + ini + '</div>') +
>       '<div class="pdv-hf-nome">' + pdvEscHtml(p.nome) + '</div>' + plu + (esgotado ? '<div class="pdv-hf-codigo" style="color:var(--danger)">Esgotado</div>' : '') + '</button>';
>   }).join('') || '<div style="color:var(--ghost);font-size:12.5px">Sem produtos nesta categoria.</div>';
>   const pg = document.getElementById('pdv-hf-pager');
>   pg.innerHTML = paginas > 1 ? '<button type="button" class="syn-btn ghost" style="padding:4px 10px;font-size:12px" onclick="pdvHfMudarPagina(-1)" ' + (pdvHfPagina === 0 ? 'disabled' : '') + '>◀ PgUp</button><span>Página ' + (pdvHfPagina + 1) + ' de ' + paginas + '</span><button type="button" class="syn-btn ghost" style="padding:4px 10px;font-size:12px" onclick="pdvHfMudarPagina(1)" ' + (pdvHfPagina >= paginas - 1 ? 'disabled' : '') + '>PgDn ▶</button>' : '';
