      "name": "Prepara contato",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const conv = $('Harpa — Conversa').first().json;\nconst s = (conv.meta && conv.meta.sender) || {};\nconst tel = String(s.phone_number || '').replace(/\\D/g, '');\nreturn [{ json: { tem_tel: tel.length >= 8, tel, ult4: tel.slice(-4) } }];\n"
      }
    },
