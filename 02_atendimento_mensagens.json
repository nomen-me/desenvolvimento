    },
    {
      "id": "7cef1105-6165-5716-a519-b37adab72111",
      "name": "Resolve cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tel = $('Prepara contato').first().json.tel;\nconst cand = (($input.first().json.data) || []).filter(c => {\n  const d = String(c.mobile_no || '').replace(/\\D/g, '');\n  return d.length >= 8 && (tel.endsWith(d.slice(-9)) || d.endsWith(tel.slice(-9)));\n});\nconst nomes = [...new Set(cand.map(c => c.name))];\nif (nomes.length !== 1) return [{ json: { unico: false, ambiguo: nomes.length > 1 } }];\nconst c = cand[0]; const doc = String(c.tax_id || '').replace(/\\D/g, '');\nreturn [{ json: { unico: true, name: c.name, cpf: doc.length === 11 ? doc : null } }];\n"
      }
    },
