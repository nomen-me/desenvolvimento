        1820,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ERPNEXT_DOMAIN.replace(/\\/+$/, '') }}/api/resource/Customer",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "=[\"name\",\"customer_name\",\"tax_id\",\"mobile_no\"]"
            },
            {
              "name": "filters",
              "value": "={{ JSON.stringify([[\"mobile_no\",\"like\",\"%\" + $json.ult4]]) }}"
            },
