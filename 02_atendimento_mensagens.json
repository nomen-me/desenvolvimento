    {
      "id": "814072a5-b3a6-51f5-8f31-9ece07a5e7df",
      "name": "Monta resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const conv = $('Harpa — Conversa').first().json;\nconst s = (conv.meta && conv.meta.sender) || {};\nconst vistos = new Set(); const bruto = [];\nfor (const it of $('Harpa — Mensagens').all()) for (const m of (it.json.payload || [])) {\n  if (vistos.has(m.id)) continue; vistos.add(m.id); bruto.push(m);\n}\nbruto.sort((a, b) => (a.created_at || 0) - (b.created_at || 0) || a.id - b.id);\nconst tipo = (m) => (m.message_type === 0 || m.message_type === 'incoming') ? 'in'\n  : (m.message_type === 2 || m.message_type === 'activity') ? 'act' : 'out';\nconst mensagens = bruto.filter(m => !m.private && tipo(m) !== 'act').map(m => {\n  const anexos = (m.attachments || []).map(a => a.file_name || String(a.data_url || '').split('?')[0].split('/').pop()).filter(Boolean);\n  let texto = m.content || '';\n  if (!texto && anexos.length) texto = 'Anexo: ' + anexos.join(', ');\n  const autor = tipo(m) === 'in' ? 'cliente' : ((m.sender && m.sender.type === 'agent_bot') ? 'sistema' : 'agente');\n  return { autor, hora: new Date((m.created_at || 0) * 1000).toISOString(), texto };\n});\nlet cpf = null, pedidos = [];\ntry { cpf = $('Resolve cliente').first().json.cpf || null; } catch (e) {}\ntry { pedidos = ($('Ritmo — Pedidos').first().json.data || []).map(p => ({ id: p.name })); } catch (e) {}\nconst tel = String(s.phone_number || '').replace(/\\D/g, '');\nreturn [{ json: { status: 200, body: {\n  mensagens,\n  cliente: { nome: s.name || null, cpf, contato: tel || s.email || s.identifier || null },\n  ultimos_pedidos: pedidos\n} } }];\n"
      }
    },
    {
      "id": "97236147-d39a-5c42-b5dc-4cd9cee25352",
      "name": "Formata erro Harpa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const it = $input.first().json || {};\nconst e = it.error || it;\nconst raw = String(e.description || e.message || 'erro desconhecido');\nconst upstream = Number(e.httpCode || e.statusCode || e.status || (e.cause && e.cause.status) || 0);\nconst clean = raw.replace(/https?:\\/\\/\\S+/g, '[url]').replace(/(token|api_access_token|authorization)\\S*/gi, '[omitido]').slice(0, 300);\nconst status = upstream === 404 ? 404 : 502;\nconst m = \"Falha ao consultar a conversa no Harpa\" + (upstream ? ' (HTTP ' + upstream + ')' : '') + (true ? ': ' + clean : '');\nreturn [{ json: { status, body: { sucesso: false, erro: m, message: m, origem: \"harpa\" } } }];\n"
      }
    },
