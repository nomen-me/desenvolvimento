      "name": "Prepara Ação de Alto Impacto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { funcao, argumentos = {} } = $json.body || $json;\nlet metodo = 'POST', path = '', body = {};\n\nif (funcao === 'processar_pedido') {\n  const acao = argumentos.acao;\n  if (acao === 'criar_venda') {\n    metodo = 'POST';\n    path = '/api/resource/Sales%20Order';\n    body = { items: (argumentos.itens || []).map(i => ({ item_code: i.produto_id, qty: i.quantidade, rate: i.preco_unitario })) };\n  } else if (acao === 'confirmar') {\n    if (!argumentos.id_pedido) throw new Error('id_pedido é obrigatório para confirmar');\n    metodo = 'PUT';\n    path = `/api/resource/Sales%20Order/${encodeURIComponent(argumentos.id_pedido)}`;\n    body = { status: 'To Deliver and Bill' };\n  } else if (acao === 'cancelar' || acao === 'estornar') {\n    // Cancelamento NÃO é um PUT simples: cadeia própria (ramo \"É Cancelar/Estornar?\").\n    if (!argumentos.id_pedido) throw new Error('id_pedido é obrigatório para ' + acao);\n    if (!argumentos.motivo) throw new Error('motivo é obrigatório para ' + acao + ' (auditoria)');\n  } else {\n    throw new Error('acao inválida para processar_pedido: ' + acao);\n  }\n} else if (funcao === 'faturamento_expedicao') {\n  if (!argumentos.id_pedido) throw new Error('id_pedido é obrigatório para faturamento_expedicao');\n  metodo = 'POST';\n  path = '/api/method/erpnext.selling.doctype.sales_order.sales_order.make_sales_invoice';\n  body = { source_name: argumentos.id_pedido };\n} else {\n  throw new Error('Função desconhecida: ' + funcao);\n}\nconst src = $json.body || $json;\nreturn [{ json: { funcao, acao: argumentos.acao, id_pedido: argumentos.id_pedido, motivo: argumentos.motivo, metodo, path, body, conversa_id: src.conversa_id, tenant_id: src.tenant_id } }];\n"
      }
    },
