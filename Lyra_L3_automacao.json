        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst meta = $('Prepara Ação de Alto Impacto').first().json;\nconst err = input.error;\nconst sucesso = !err;\nconst dados = input.data !== undefined ? input.data : (input.message !== undefined ? input.message : (err ? null : input));\nreturn [{ json: { conversa_id: meta.conversa_id, tenant_id: meta.tenant_id, funcao: meta.funcao, sucesso, dados,\n  erro: err ? String(err.description || err.message || err).slice(0, 300) : null,\n  aviso: (sucesso && meta.funcao === 'faturamento_expedicao') ? 'Fatura gerada como rascunho — submissão final (emissão de NF-e) exige confirmação separada, ainda não automatizada.' : null } }];\n"
      }
