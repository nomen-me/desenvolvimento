    {
      "id": "50381a1e-b6bd-54e7-a1dd-f26b06c807ea",
      "name": "Avalia Cadeia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ped = $('Avalia Pedido').first().json;\nconst lista = (n) => { const r = $(n).first().json; if (r.statusCode !== 200) throw new Error(n + ': HTTP ' + r.statusCode); return (r.body && r.body.data) || []; };\nlet fat, ent, pag;\ntry { fat = lista('Ritmo — Faturas vinculadas'); ent = lista('Ritmo — Entregas vinculadas'); pag = lista('Ritmo — Pagamentos vinculados'); }\ncatch (e) { return [{ json: { ...ped, final: true, sucesso: false, erro: 'Não foi possível verificar documentos vinculados (' + e.message + ') — nada foi alterado' } }]; }\nconst pend = [];\nif (fat.length) pend.push('nota fiscal/fatura (' + fat.map(x => x.name).join(', ') + '): cancelamento ou devolução fiscal via brazil_nf — endpoint não confirmado');\nif (ent.length) pend.push('entrega já realizada (' + ent.map(x => x.name).join(', ') + '): retorno físico, análise de integridade, etiqueta de devolução e reposição — não automatizados');\nif (pag.length) pend.push('pagamento recebido (' + pag.map(x => x.name).join(', ') + '): estorno/reembolso — API de estorno da InfinitePay não confirmada');\nif (pend.length) return [{ json: { ...ped, final: true, sucesso: false, hold: true, etapa_pendente: pend, erro: 'HOLD: o estado do pedido não permite cancelamento seguro automático — nada foi alterado. Pendente: ' + pend.join(' | ') } }];\nreturn [{ json: { ...ped, final: false, executavel: true } }];\n"
      }
    },
