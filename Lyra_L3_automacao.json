    {
      "id": "91ee22f8-9380-5399-8e6a-328cdd612ca8",
      "name": "Avalia Pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $('Prepara Ação de Alto Impacto').first().json;\nconst r = $input.first().json; const doc = r.body && r.body.data;\nconst operation_id = 'cancelar_pedido:' + meta.id_pedido;   // determinístico: mesmo pedido → mesma operação\nconst base = { conversa_id: meta.conversa_id, tenant_id: meta.tenant_id, funcao: 'processar_pedido', operation_id };\nconst out = (o) => [{ json: Object.assign({}, base, o) }];\nif (meta.acao === 'estornar') return out({ final: true, sucesso: false, hold: true, etapa_pendente: 'estorno_infinitepay', erro: 'HOLD: estorno de pagamento depende de API de estorno da InfinitePay ainda não confirmada — nada foi alterado' });\nif (r.statusCode === 404) return out({ final: true, sucesso: false, erro: 'Pedido ' + meta.id_pedido + ' não encontrado no Ritmo' });\nif (r.statusCode !== 200 || !doc) return out({ final: true, sucesso: false, erro: 'Falha ao consultar o pedido no Ritmo (HTTP ' + r.statusCode + ')' });\nif (doc.docstatus === 2) return out({ final: true, sucesso: true, ja_cancelado: true, dados: { id_pedido: doc.name, status: doc.status }, aviso: 'Pedido já estava cancelado — nenhuma alteração feita (idempotente)' });\nif (doc.docstatus === 0) return out({ final: true, sucesso: false, erro: 'Pedido ' + doc.name + ' é rascunho: não há o que cancelar' });\nreturn out({ final: false, id_pedido: doc.name, modified: doc.modified });\n"
      }
    },
