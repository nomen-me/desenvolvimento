      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ped = $('Avalia Pedido').first().json; const r = $input.first().json; const doc = r.body && r.body.data;\nconst base = { conversa_id: ped.conversa_id, tenant_id: ped.tenant_id, funcao: 'processar_pedido', operation_id: ped.operation_id };\nif (r.statusCode === 200 && doc && doc.docstatus === 2) return [{ json: { ...base, sucesso: true, dados: { id_pedido: doc.name, status: doc.status, docstatus: doc.docstatus, etapas: ['pedido cancelado no Ritmo (nativo)'] }, erro: null } }];\nreturn [{ json: { ...base, sucesso: false, erro: 'Cancelamento NÃO confirmado: o pedido não está cancelado no Ritmo após a execução (HTTP ' + r.statusCode + ')' } }];\n"
      }
