        "jsCode": "const meta = $('Prepara Ação de Alto Impacto').first().json;\nconst e = ($input.first().json || {}).error || {};\nconst raw = String(e.description || e.message || 'erro desconhecido').replace(/https?:\\/\\/\\S+/g, '[url]').slice(0, 300);\nreturn [{ json: { conversa_id: meta.conversa_id, tenant_id: meta.tenant_id, funcao: meta.funcao, operation_id: 'cancelar_pedido:' + meta.id_pedido, sucesso: false, dados: null, erro: 'Falha na execução no Ritmo: ' + raw } }];\n"
      }
